# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be in 7680-7689.
PORT=7680
# A2ALAB_BIND=127.0.0.1   # loopback only unless you set this on purpose
# Rule 27 run observability (Real mode is reserved in this lab, so nothing reads these yet). A LOOPBACK Elasticsearch URL (a port-forward)
# and a READ-ONLY API key the owner creates. Leave empty for Mock. Never mount the Docker socket into the lab.
RUN_OBS_ES_URL=
RUN_OBS_ES_READ_APIKEY=
